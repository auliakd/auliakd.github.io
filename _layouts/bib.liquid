
<article class="publication-entry row align-items-start mb-4">

  <!-- Publication Thumbnail -->
  {% if site.enable_publication_thumbnails %}
    <div class="col-12 col-sm-3 publication-thumbnail mb-3 mb-sm-0">
      {% if entry.preview %}
        {% if entry.preview contains '://' %}
          <img
            class="img-fluid rounded publication-preview"
            src="{{ entry.preview }}"
            alt="Preview of {{ entry.title }}"
          >
        {% else %}
          {% assign entry_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
          {% include figure.liquid
            path=entry_path
            class="img-fluid rounded publication-preview"
            alt=entry.title
          %}
        {% endif %}
      {% else %}
        {% if entry.abbr %}
          <div class="publication-placeholder rounded">
            <span>{{ entry.abbr }}</span>
          </div>
        {% endif %}
      {% endif %}
    </div>
  {% endif %}

  <!-- Publication Information -->
  <div
    id="{{ entry.key }}"
    class="{% if site.enable_publication_thumbnails %}col-12 col-sm-9{% else %}col-12{% endif %} publication-content"
  >

    <!-- Publication Title -->
    <h5 class="publication-title">
      {% if entry.doi %}
        <a href="https://doi.org/{{ entry.doi }}" target="_blank" rel="noopener">
          {{ entry.title }}
        </a>
      {% elsif entry.url %}
        <a href="{{ entry.url }}" target="_blank" rel="noopener">
          {{ entry.title }}
        </a>
      {% else %}
        {{ entry.title }}
      {% endif %}
    </h5>

    <!-- Authors -->
    <div class="publication-authors">
      {% for author in entry.author_array %}
        {% assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' %}
        {% assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' %}

        {% assign author_is_self = false %}
        {% if site.scholar.last_name contains author_last_name %}
          {% if site.scholar.first_name contains author.first %}
            {% assign author_is_self = true %}
          {% endif %}
        {% endif %}

        {% assign coauthor_url = null %}
        {% assign clean_last_name = author_last_name | downcase | remove_accents %}

        {% if site.data.coauthors[clean_last_name] %}
          {% for coauthor in site.data.coauthors[clean_last_name] %}
            {% if coauthor.firstname contains author.first %}
              {% assign coauthor_url = coauthor.url %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% unless forloop.first %}, {% endunless %}

        {% if author_is_self %}
          <em>{{ author.first }} {{ author_last_html }}</em>
        {% elsif coauthor_url %}
          <a href="{{ coauthor_url }}" target="_blank" rel="noopener">
            {{ author.first }} {{ author_last_html }}
          </a>
        {% else %}
          {{ author.first }} {{ author_last_html }}
        {% endif %}
      {% endfor %}
    </div>

    <!-- Journal and Publication Year -->
    <div class="publication-journal">
      {% if entry.journal %}
        <em>{{ entry.journal }}</em>
      {% elsif entry.booktitle %}
        <em>{{ entry.booktitle }}</em>
      {% elsif entry.publisher %}
        {{ entry.publisher }}
      {% endif %}

      {% if entry.volume %}
        , {{ entry.volume }}
      {% endif %}

      {% if entry.pages %}
        , pp. {{ entry.pages }}
      {% endif %}

      {% if entry.year %}
        , {{ entry.year }}
      {% endif %}
    </div>

    <!-- Publication Note -->
    {% if entry.note %}
      <div class="publication-note">
        {{ entry.note }}
      </div>
    {% endif %}

    <!-- Publication Links -->
    <div class="publication-links">

      {% if entry.doi %}
        <a
          href="https://doi.org/{{ entry.doi }}"
          class="btn btn-sm z-depth-0"
          target="_blank"
          rel="noopener"
        >DOI</a>
      {% endif %}

      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}
          <a
            href="{{ entry.pdf }}"
            class="btn btn-sm z-depth-0"
            target="_blank"
            rel="noopener"
          >PDF</a>
        {% else %}
          <a
            href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}"
            class="btn btn-sm z-depth-0"
            target="_blank"
          >PDF</a>
        {% endif %}
      {% endif %}

      {% if entry.html %}
        {% if entry.html contains '://' %}
          <a
            href="{{ entry.html }}"
            class="btn btn-sm z-depth-0"
            target="_blank"
            rel="noopener"
          >Paper</a>
        {% else %}
          <a
            href="{{ entry.html | prepend: '/assets/html/' | relative_url }}"
            class="btn btn-sm z-depth-0"
            target="_blank"
          >Paper</a>
        {% endif %}
      {% endif %}

      {% if entry.bibtex_show %}
        <button class="bibtex btn btn-sm z-depth-0" type="button">
         BibTeX
        </button>
      {% endif %}

      {% if entry.code %}
        <a
          href="{{ entry.code }}"
          class="btn btn-sm z-depth-0"
          target="_blank"
          rel="noopener"
        >Code</a>
      {% endif %}

      {% if entry.website %}
        <a
          href="{{ entry.website }}"
          class="btn btn-sm z-depth-0"
          target="_blank"
          rel="noopener"
        >Website</a>
      {% endif %}

    </div>

    <!-- Abstract -->
    {% if entry.abstract %}
      <div class="abstract hidden">
        <p>{{ entry.abstract }}</p>
      </div>
    {% endif %}

    <!-- BibTeX Data -->
    {% if entry.bibtex_show %}
      <div class="bibtex hidden">
        {% highlight bibtex %}
          {{- entry.bibtex | hideCustomBibtex -}}
        {% endhighlight %}
      </div>
    {% endif %}

  </div>
</article>
